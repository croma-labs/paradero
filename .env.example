# Reads TransMilenio through Croma. Free key: https://platform.usecroma.com/sign-up
CROMA_API_KEY=
# Optional. Defaults to https://api.croma.run
CROMA_API_URL=
# Optional. Lets riders report problems from the app without a GitHub account.
# A fine-grained token with only "Issues: read and write" on the reports repo.
GITHUB_REPORTS_TOKEN=
# Optional. Defaults to croma-labs/paradero
REPORTS_REPO=
# Optional. Signs the place ids /api/places and resolve_place hand out. Defaults to a key derived from CROMA_API_KEY.
PARADERO_PLACE_SECRET=
# Optional. Where the planner reads its data (public/network). Defaults to https://paradero.expo.app/network, or the local server in development.
PARADERO_NETWORK_URL=
